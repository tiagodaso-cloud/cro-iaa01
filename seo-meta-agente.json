      "id": "a91b94aa-2c9d-45f9-829b-353e529b83ae",
      "name": "Carregar Licoes",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [448, 112],
      "executeOnce": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const convs=$('Carregar Conversas').all().map(i=>i.json);const lic=$('Carregar Licoes').all().filter(i=>i.json.chave==='global').map(i=>i.json.licoes).join('\\n')||'(vazio)';const s=convs.length>20?[...convs].sort(()=>0.5-Math.random()).slice(0,20):convs;const txt=s.map((c,i)=>'#'+(i+1)+' '+String(c.mensagem||'').slice(0,300)+'\\n'+String(c.resposta||'').slice(0,500)).join('\\n\\n');return[{json:{total:s.length,prompt:'Licoes:\\n'+lic+'\\n\\nConversas:\\n'+txt}}];"
      },
      "id": "887eb1d0-a661-4dee-b848-565802c8fc63",
      "name": "Preparar Avaliação",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [672, 112]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.prompt }}",
        "options": {
          "systemMessage": "Voce e o Supervisor de Qualidade do SEO Orchestrator. Avalie a amostra de conversas e retorne um JSON com: score_geral (0-10), total_avaliadas, status (excelente/bom/atencao/critico), padroes_fracos (lista), recomendacoes (lista), resumo (string).",
          "maxIterations": 2
        }
      },
      "id": "4722d659-3073-4eda-b5cd-587d89b8535b",
      "name": "Agente Supervisor",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [896, 112]
    },
    {
      "parameters": {
        "model": "anthropic/claude-sonnet-4.6",
        "options": {
          "maxTokens": 2048,
          "temperature": 0.3,
          "timeout": 120000
        }
      },
      "id": "7295b343-132b-4761-968a-ebf7476a6608",
      "name": "LLM Supervisor",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [976, 336]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw=$input.first()?.json?.output||'';let av={};try{const m=raw.match(/[{][\\s\\S]*[}]/);av=m?JSON.parse(m[0]):{}}catch(e){}const score=typeof av.score_geral==='number'?av.score_geral:7;const p=Array.isArray(av.padroes_fracos)?av.padroes_fracos:[];const r=Array.isArray(av.recomendacoes)?av.recomendacoes:[];const tot=$('Preparar Avaliação').first()?.json?.total||0;return[{json:{score_medio:score,status:av.status||'bom',total_conversas:tot,padroes_fracos:p.join('; '),recomendacoes_texto:r.length?'- '+r.join('\\n- '):'',recomendacoes_lista:r,precisa_ajuste:score<7||p.length>2,resumo:av.resumo||'',data_avaliacao:new Date().toISOString().split('T')[0]}}];"
      },
      "id": "9be2d665-3a45-4770-9ca2-48ff7c63f16d",
      "name": "Extrair Resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1248, 112]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.precisa_ajuste }}",
              "operator": {
                "type": "boolean",
                "operation": "true"
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        }
      },
      "id": "c6ed75a7-b924-4e86-ac00-641779acc4ab",
      "name": "IF Precisa Ajuste",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
