    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r=$('Extrair Resultado').first().json;const com=('Acoes recomendadas: '+(r.recomendacoes_texto||'(nenhuma)')+' / Padroes fracos: '+(r.padroes_fracos||'(nenhum)')).slice(0,480);return[{json:{rating:'down',comentario:com,mensagem_usuario:'[Supervisor de Qualidade] avaliacao automatica',resposta_assistente:String(r.resumo||'').slice(0,1500),url_analisada:'',topico:'meta-supervisor',criado_em:new Date().toISOString()}}];"
