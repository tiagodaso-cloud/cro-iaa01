{
  "name": "SEO Intelligence Orchestrator",
  "nodes": [
    {
      "id": "get-01",
      "name": "GET – Serve HTML",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        200
      ],
      "webhookId": "seo-intelligence",
      "parameters": {
        "httpMethod": "GET",
        "path": "seo-intelligence",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "get-02",
      "name": "Responder HTML",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        500,
        200
      ],
      "parameters": {
        "respondWith": "text",
        "responseBody": "<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n  <meta charset=\"UTF-8\"/>\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\n  <title>SEO Intelligence Hub</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\"/>\n  <script src=\"https://cdn.jsdelivr.net/npm/marked/marked.min.js\"></script>\n  <style>\n    :root{--ox:#FF5C28;--ox2:#e84e1b;--dark:#111827;--card:#1f2937;--border:#374151;--text:#f9fafb;--muted:#9ca3af;--green:#10b981;--yellow:#f59e0b;--red:#ef4444;--blue:#3b82f6;--purple:#8b5cf6}\n    *{box-sizing:border-box;margin:0;padding:0}\n    body{font-family:'Plus Jakarta Sans',sans-serif;background:var(--dark);color:var(--text);height:100vh;display:flex;flex-direction:column;overflow:hidden}\n\n    /* Header */\n    header{background:rgba(17,24,39,.95);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);padding:0 24px;height:60px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;z-index:100}\n    .hbrand{display:flex;align-items:center;gap:12px}\n    .logo{width:30px;height:30px;background:linear-gradient(135deg,var(--ox2),var(--ox));border-radius:7px;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:14px;color:#fff}\n    .btext{font-size:15px;font-weight:700}.btext span{color:var(--ox)}\n    .hub-badge{background:linear-gradient(135deg,#6d28d9,#8b5cf6);color:#fff;font-size:10px;font-weight:700;padding:3px 9px;border-radius:20px;letter-spacing:.5px;text-transform:uppercase}\n    .hmeta{display:flex;align-items:center;gap:8px}\n    .sdot{width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 6px var(--green)}\n    .stext{font-size:12px;color:var(--muted)}\n\n    /* Chat layout */\n    .chat-wrap{flex:1;overflow:hidden;display:flex;flex-direction:column}\n    .messages{flex:1;overflow-y:auto;padding:24px;display:flex;flex-direction:column;gap:16px;scroll-behavior:smooth}\n    .messages::-webkit-scrollbar{width:4px}\n    .messages::-webkit-scrollbar-thumb{background:var(--border);border-radius:2px}\n\n    /* Welcome */\n    .welcome{flex:1;display:flex;align-items:center;justify-content:center;padding:24px}\n    .wcard{max-width:460px;text-align:center}\n    .wicon{width:64px;height:64px;background:linear-gradient(135deg,var(--ox2),var(--ox));border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:28px;margin:0 auto 20px}\n    .wcard h2{font-size:22px;font-weight:800;margin-bottom:10px}\n    .wcard p{font-size:14px;color:var(--muted);line-height:1.6;margin-bottom:20px}\n    .wchips{display:flex;flex-wrap:wrap;gap:8px;justify-content:center}\n    .wchip{background:var(--card);border:1px solid var(--border);border-radius:20px;padding:5px 13px;font-size:12px;color:var(--muted)}\n    .wexample{margin-top:20px;background:rgba(255,92,40,.08);border:1px dashed rgba(255,92,40,.3);border-radius:10px;padding:12px 16px;font-size:13px;color:var(--muted);text-align:left}\n    .wexample strong{color:var(--ox);display:block;margin-bottom:4px;font-size:11px;text-transform:uppercase;letter-spacing:.5px}\n\n    /* Message rows */\n    .mrow{display:flex;align-items:flex-end;gap:10px;max-width:100%}\n    .mrow.user{flex-direction:row-reverse}\n    .mavatar{width:32px;height:32px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700}\n    .mrow.assistant .mavatar{background:linear-gradient(135deg,var(--ox2),var(--ox));color:#fff}\n    .mrow.user .mavatar{background:var(--card);color:var(--muted);border:1px solid var(--border)}\n    .mbubble{max-width:min(680px,calc(100% - 80px));padding:12px 16px;border-radius:16px;font-size:14px;line-height:1.6}\n    .mrow.user .mbubble{background:linear-gradient(135deg,var(--ox2),var(--ox));color:#fff;border-bottom-right-radius:4px}\n    .mrow.assistant .mbubble{background:var(--card);border:1px solid var(--border);color:var(--text);border-bottom-left-radius:4px}\n    .mbubble p:not(:last-child){margin-bottom:8px}\n    .mbubble ul,.mbubble ol{padding-left:20px;margin:8px 0}\n    .mbubble li{margin-bottom:4px}\n    .mbubble strong{color:var(--ox)}\n    .mbubble h2,.mbubble h3{font-size:14px;font-weight:700;margin:12px 0 6px;color:var(--ox)}\n    .mbubble code{background:rgba(0,0,0,.3);padding:1px 5px;border-radius:4px;font-size:12px}\n    .mbubble hr{border:none;border-top:1px solid var(--border);margin:12px 0}\n    .mbubble a{color:var(--ox);text-decoration:none}\n    .mbubble blockquote{border-left:3px solid var(--ox);padding-left:10px;color:var(--muted);margin:8px 0}\n\n    /* Analysis report */\n    .areport{max-width:min(820px,calc(100% - 42px));display:flex;flex-direction:column;gap:10px}\n    .rheader{background:linear-gradient(135deg,var(--ox2),var(--ox));border-radius:12px;padding:16px 20px}\n    .rheader h2{font-size:16px;font-weight:800;color:#fff;margin-bottom:4px}\n    .rheader p{font-size:12px;color:rgba(255,255,255,.8)}\n    .rsection{background:var(--card);border:1px solid var(--border);border-radius:10px;overflow:hidden}\n    .stoggle{width:100%;padding:13px 16px;background:none;border:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;color:var(--text);font-family:inherit;font-size:13px;font-weight:600}\n    .stoggle:hover{background:rgba(255,255,255,.03)}\n    .stitle{display:flex;align-items:center;gap:8px}\n    .sico{font-size:15px}\n    .schevron{font-size:10px;color:var(--muted);transition:transform .2s}\n    .stoggle.open .schevron{transform:rotate(180deg)}\n    .sbody{padding:0 16px 14px}\n\n    /* KPI */\n    .kpi-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:8px;margin-bottom:12px}\n    .kpi{background:rgba(255,255,255,.04);border:1px solid var(--border);border-radius:8px;padding:10px 14px;text-align:center}\n    .kpi-lbl{font-size:11px;color:var(--muted);margin-bottom:4px}\n    .kpi-val{font-size:20px;font-weight:800;color:var(--ox)}\n\n    /* Insights */\n    .ilist{display:flex;flex-direction:column;gap:6px}\n    .iitem{display:flex;align-items:flex-start;gap:10px;background:rgba(255,255,255,.03);border-left:3px solid var(--ox);border-radius:0 6px 6px 0;padding:10px 12px;font-size:13px;line-height:1.5}\n    .inum{width:20px;height:20px;background:var(--ox);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;flex-shrink:0;margin-top:1px}\n\n    /* Item cards */\n    .icards{display:flex;flex-direction:column;gap:8px}\n    .icard{background:rgba(255,255,255,.03);border:1px solid var(--border);border-radius:8px;padding:12px 14px}\n    .icard-hd{display:flex;align-items:center;gap:8px;margin-bottom:6px}\n    .sbadge{font-size:10px;font-weight:700;padding:2px 8px;border-radius:20px;text-transform:uppercase;letter-spacing:.5px}\n    .salta{background:rgba(239,68,68,.15);color:#ef4444}\n    .smedia{background:rgba(245,158,11,.15);color:#f59e0b}\n    .sbaixa{background:rgba(16,185,129,.15);color:#10b981}\n    .ititle{font-size:13px;font-weight:600;flex:1}\n    .idesc{font-size:12px;color:var(--muted);line-height:1.5;margin-bottom:8px}\n    .imeta{display:flex;flex-wrap:wrap;gap:6px}\n    .mchip{font-size:11px;padding:2px 8px;border-radius:20px;border:1px solid var(--border);color:var(--muted)}\n    .wftag{font-size:11px;padding:2px 8px;border-radius:20px;background:rgba(59,130,246,.15);color:#60a5fa}\n\n    /* CWV note */\n    .cnote{display:flex;align-items:center;gap:8px;padding:10px 14px;border-radius:8px;font-size:12px;line-height:1.5}\n    .csent{background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.3);color:#10b981}\n    .cpending{background:rgba(245,158,11,.1);border:1px solid rgba(245,158,11,.3);color:#f59e0b}\n\n    /* Loading */\n    .lbubble{background:var(--card);border:1px solid var(--border);border-radius:16px;border-bottom-left-radius:4px;padding:14px 18px;display:flex;flex-direction:column;gap:10px;max-width:300px}\n    .ltitle{font-size:13px;font-weight:600}\n    .lsteps{display:flex;flex-direction:column;gap:4px}\n    .lstep{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--muted);padding:3px 0;transition:color .3s}\n    .lstep.active{color:var(--ox)}.lstep.done{color:var(--green)}\n    .ldot{width:8px;height:8px;border-radius:50%;background:var(--border);flex-shrink:0;transition:background .3s}\n    .lstep.active .ldot{background:var(--ox);box-shadow:0 0 6px var(--ox);animation:dot-pulse 1s infinite}\n    .lstep.done .ldot{background:var(--green)}\n    @keyframes dot-pulse{0%,100%{opacity:1}50%{opacity:.3}}\n    .ltimer{font-size:11px;color:var(--muted)}\n    .ltyping{display:flex;gap:4px;align-items:center;padding:4px 0}\n    .ltyping span{width:7px;height:7px;border-radius:50%;background:var(--muted);animation:dot-pulse 1s infinite}\n    .ltyping span:nth-child(2){animation-delay:.2s}\n    .ltyping span:nth-child(3){animation-delay:.4s}\n\n    /* Input */\n    .iarea{padding:16px 24px;border-top:1px solid var(--border);background:rgba(17,24,39,.95);backdrop-filter:blur(12px);flex-shrink:0}\n    .iwrap{max-width:820px;margin:0 auto;display:flex;align-items:flex-end;gap:10px;background:var(--card);border:1px solid var(--border);border-radius:12px;padding:10px 10px 10px 16px;transition:border-color .2s}\n    .iwrap:focus-within{border-color:var(--ox)}\n    #inp{flex:1;background:none;border:none;outline:none;color:var(--text);font-family:inherit;font-size:14px;line-height:1.5;resize:none;max-height:120px;min-height:22px}\n    #inp::placeholder{color:var(--muted)}\n    .sbtn{width:36px;height:36px;border-radius:8px;background:linear-gradient(135deg,var(--ox2),var(--ox));border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:opacity .2s,transform .1s}\n    .sbtn:hover{opacity:.9;transform:scale(1.05)}.sbtn:disabled{opacity:.4;cursor:not-allowed;transform:none}\n    .sbtn svg{width:16px;height:16px;fill:#fff}\n    .ihint{font-size:11px;color:var(--muted);text-align:center;margin-top:8px}\n  </style>\n</head>\n<body>\n\n<header>\n  <div class=\"hbrand\">\n    <div class=\"logo\">C</div>\n    <span class=\"btext\">SEO <span>Intelligence</span></span>\n    <span class=\"hub-badge\">Hub</span>\n  </div>\n  <div class=\"hmeta\">\n    <div class=\"sdot\" id=\"sdot\"></div>\n    <span class=\"stext\" id=\"stxt\">Online</span>\n  </div>\n</header>\n\n<div class=\"chat-wrap\">\n  <div class=\"messages\" id=\"msgs\">\n    <div class=\"welcome\" id=\"welcome\">\n      <div class=\"wcard\">\n        <div class=\"wicon\">🔍</div>\n        <h2>SEO Intelligence Hub</h2>\n        <p>Envie uma URL e um tópico para análise completa com Query Fan-out, GEO Mapping, On-Page SEO e Core Web Vitals. Depois, explore os resultados conversando.</p>\n        <div class=\"wchips\">\n          <span class=\"wchip\">Query Fan-out 3 LLMs</span>\n          <span class=\"wchip\">GEO Mapping</span>\n          <span class=\"wchip\">On-Page Audit</span>\n          <span class=\"wchip\">Core Web Vitals</span>\n          <span class=\"wchip\">Correlação multi-fonte</span>\n          <span class=\"wchip\">Chat analítico</span>\n        </div>\n        <div class=\"wexample\">\n          <strong>Exemplo de uso</strong>\n          https://centauro.com.br tênis de corrida\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"iarea\">\n    <div class=\"iwrap\">\n      <textarea id=\"inp\" rows=\"1\" placeholder=\"Ex: https://centauro.com.br tênis de corrida\" autocomplete=\"off\"></textarea>\n      <button class=\"sbtn\" id=\"sbtn\" onclick=\"send()\">\n        <svg viewBox=\"0 0 24 24\"><path d=\"M2.01 21L23 12 2.01 3 2 10l15 2-15 2z\"/></svg>\n      </button>\n    </div>\n    <div class=\"ihint\" id=\"hint\">Informe URL + tópico para iniciar · Enter para enviar · Shift+Enter para nova linha</div>\n  </div>\n</div>\n\n<script>\n  const IS_TEST = location.pathname.includes('webhook-test');\n  const BASE = IS_TEST\n    ? 'https://n8n-prod.cadastra.com/webhook-test/seo-intelligence'\n    : 'https://n8n-prod.cadastra.com/webhook/seo-intelligence';\n\n  let analysisContext = null;\n  let history = [];\n  let busy = false;\n  let timerInt = null;\n\n  const msgsEl = document.getElementById('msgs');\n  const inp = document.getElementById('inp');\n  const sbtn = document.getElementById('sbtn');\n  const hintEl = document.getElementById('hint');\n  const sdot = document.getElementById('sdot');\n  const stxt = document.getElementById('stxt');\n\n  inp.addEventListener('input', () => {\n    inp.style.height = 'auto';\n    inp.style.height = Math.min(inp.scrollHeight, 120) + 'px';\n  });\n  inp.addEventListener('keydown', e => {\n    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(); }\n  });\n\n  function esc(s) {\n    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\n  }\n  function scroll() { msgsEl.scrollTop = msgsEl.scrollHeight; }\n\n  function setStatus(ok) {\n    sdot.style.background = ok ? 'var(--green)' : 'var(--red)';\n    sdot.style.boxShadow = ok ? '0 0 6px var(--green)' : 'none';\n    stxt.textContent = ok ? 'Online' : 'Offline';\n  }\n\n  function removeWelcome() {\n    document.getElementById('welcome')?.remove();\n  }\n\n  function addUserBubble(text) {\n    removeWelcome();\n    const row = document.createElement('div');\n    row.className = 'mrow user';\n    row.innerHTML = `<div class=\"mavatar\">U</div><div class=\"mbubble\">${esc(text)}</div>`;\n    msgsEl.appendChild(row);\n    scroll();\n  }\n\n  function addLoadingBubble(isAnalysis) {\n    const row = document.createElement('div');\n    row.className = 'mrow assistant';\n    row.id = 'lbub';\n    if (isAnalysis) {\n      const steps = [\n        ['ls-fo','Query Fan-out (3 LLMs)'],\n        ['ls-ge','GEO Mapping'],\n        ['ls-op','On-Page Audit'],\n        ['ls-cw','CorePulse CWV'],\n        ['ls-ai','Correlação IA']\n      ];\n      row.innerHTML = `<div class=\"mavatar\">S</div>\n        <div class=\"lbubble\">\n          <div class=\"ltitle\">Analisando...</div>\n          <div class=\"lsteps\">${steps.map(([id,lbl])=>`<div class=\"lstep\" id=\"${id}\"><div class=\"ldot\"></div>${lbl}</div>`).join('')}</div>\n          <div class=\"ltimer\" id=\"ltmr\">0s</div>\n        </div>`;\n      msgsEl.appendChild(row);\n      scroll();\n      const timings = [0,5,20,35,90];\n      timings.forEach((t,i) => {\n        setTimeout(() => {\n          if (i > 0) document.getElementById(steps[i-1][0])?.classList.replace('active','done');\n          document.getElementById(steps[i][0])?.classList.add('active');\n        }, t * 1000);\n      });\n      let secs = 0;\n      timerInt = setInterval(() => {\n        const el = document.getElementById('ltmr');\n        if (el) el.textContent = ++secs + 's';\n      }, 1000);\n    } else {\n      row.innerHTML = `<div class=\"mavatar\">S</div>\n        <div class=\"lbubble\" style=\"padding:14px 18px\">\n          <div class=\"ltyping\"><span></span><span></span><span></span></div>\n        </div>`;\n      msgsEl.appendChild(row);\n      scroll();\n    }\n  }\n\n  function removeLoadingBubble() {\n    if (timerInt) { clearInterval(timerInt); timerInt = null; }\n    document.getElementById('lbub')?.remove();\n  }\n\n  function sevCls(p) {\n    if (!p) return 'smedia';\n    const n = String(p).toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'');\n    if (/alta|alto|high|crit/.test(n)) return 'salta';\n    if (/baixa|baixo|low/.test(n)) return 'sbaixa';\n    return 'smedia';\n  }\n\n  function renderItems(items) {\n    if (!items?.length) return '<p style=\"color:var(--muted);font-size:13px\">Nenhum item disponível.</p>';\n    return '<div class=\"icards\">' + items.map(it => {\n      const title = it.titulo || it.acao || it.passo || '';\n      const desc  = it.descricao || it.impacto_esperado || it.impacto_estimado || '';\n      const prio  = it.prioridade || '';\n      const chips = [];\n      if (it.prazo) chips.push(`⏱ ${it.prazo}`);\n      if (it.horizonte) chips.push(`📅 ${it.horizonte}`);\n      if (it.impacto_esperado && !it.prazo) chips.push(`🎯 ${it.impacto_esperado}`);\n      if (it.impacto_estimado && !it.horizonte) chips.push(`📊 ${it.impacto_estimado}`);\n      const wftags = (it.workflows||[]).map(w=>`<span class=\"wftag\">${esc(w)}</span>`).join('');\n      return `<div class=\"icard\">\n        <div class=\"icard-hd\">\n          ${prio?`<span class=\"sbadge ${sevCls(prio)}\">${esc(prio)}</span>`:''}\n          <span class=\"ititle\">${esc(title)}</span>\n        </div>\n        ${desc?`<div class=\"idesc\">${esc(desc)}</div>`:''}\n        ${chips.length||wftags?`<div class=\"imeta\">${chips.map(c=>`<span class=\"mchip\">${esc(c)}</span>`).join('')}${wftags}</div>`:''}\n      </div>`;\n    }).join('') + '</div>';\n  }\n\n  function renderAnalysis(d) {\n    const insights = (d.sumario?.insights ?? []);\n    const insHtml  = insights.map((s,i)=>`<div class=\"iitem\"><div class=\"inum\">${i+1}</div><span>${esc(s)}</span></div>`).join('');\n    const sections = [\n      { ico:'💡', title:'Sumário Executivo', open:true,\n        body:`<div class=\"kpi-row\">\n          <div class=\"kpi\"><div class=\"kpi-lbl\">Impacto</div><div class=\"kpi-val\">${esc(d.sumario?.nivel_impacto??'—')}</div></div>\n          <div class=\"kpi\"><div class=\"kpi-lbl\">Correlações</div><div class=\"kpi-val\">${(d.correlacoes??[]).length}</div></div>\n          <div class=\"kpi\"><div class=\"kpi-lbl\">Gaps</div><div class=\"kpi-val\">${(d.gaps_oportunidades??[]).length}</div></div>\n          <div class=\"kpi\"><div class=\"kpi-lbl\">Ações</div><div class=\"kpi-val\">${(d.plano_acao??[]).length}</div></div>\n        </div><div class=\"ilist\">${insHtml}</div>`\n      },\n      { ico:'🔗', title:'Correlações Detectadas', body: renderItems(d.correlacoes) },\n      { ico:'🎯', title:'Gaps e Oportunidades',    body: renderItems(d.gaps_oportunidades) },\n      { ico:'⚡', title:'Plano de Ação',           body: renderItems(d.plano_acao) },\n      { ico:'🗓', title:'Próximos Passos',         body: renderItems(d.proximos_passos) }\n    ];\n    const secHtml = sections.map(s=>`\n      <div class=\"rsection\">\n        <button class=\"stoggle${s.open?' open':''}\" onclick=\"toggleSec(this)\">\n          <div class=\"stitle\"><span class=\"sico\">${s.ico}</span>${esc(s.title)}</div>\n          <span class=\"schevron\">▼</span>\n        </button>\n        <div class=\"sbody\"${s.open?'':' style=\"display:none\"'}>${s.body}</div>\n      </div>`).join('');\n    const cwvHtml = d.cwv_email_enviado\n      ? `<div class=\"cnote csent\">✅ Relatório Core Web Vitals enviado por e-mail pelo CorePulse Analyzer.</div>`\n      : `<div class=\"cnote cpending\">⏳ CorePulse em processamento — relatório CWV chegará por e-mail.</div>`;\n    const row = document.createElement('div');\n    row.className = 'mrow assistant';\n    row.innerHTML = `<div class=\"mavatar\">S</div>\n      <div class=\"areport\">\n        <div class=\"rheader\">\n          <h2>Análise SEO Intelligence</h2>\n          <p>${esc(d.url_analisada??'')} · ${esc(d.topico??'')} · ${new Date(d.generated_at??Date.now()).toLocaleString('pt-BR')}</p>\n        </div>\n        ${secHtml}\n        ${cwvHtml}\n        <div style=\"font-size:12px;color:var(--muted);padding:2px 0\">💬 Análise concluída. Agora você pode aprofundar qualquer aspecto, pedir correlações ou explorar oportunidades específicas.</div>\n      </div>`;\n    msgsEl.appendChild(row);\n    scroll();\n  }\n\n  function addAssistantBubble(text) {\n    const row = document.createElement('div');\n    row.className = 'mrow assistant';\n    const html = typeof marked !== 'undefined' ? marked.parse(text) : esc(text).replace(/\\n/g,'<br>');\n    row.innerHTML = `<div class=\"mavatar\">S</div><div class=\"mbubble\">${html}</div>`;\n    msgsEl.appendChild(row);\n    scroll();\n  }\n\n  function toggleSec(btn) {\n    btn.classList.toggle('open');\n    const body = btn.nextElementSibling;\n    body.style.display = body.style.display === 'none' ? 'block' : 'none';\n  }\n\n  async function send() {\n    const text = inp.value.trim();\n    if (!text || busy) return;\n    busy = true;\n    sbtn.disabled = true;\n    inp.value = '';\n    inp.style.height = 'auto';\n\n    const isNew = !analysisContext;\n    addUserBubble(text);\n    addLoadingBubble(isNew);\n    if (isNew) hintEl.textContent = 'Análise em andamento... 1–3 minutos';\n\n    try {\n      const res = await fetch(BASE, {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({ message: text, history, analysisContext })\n      });\n      if (!res.ok) throw new Error('HTTP ' + res.status);\n      const data = await res.json();\n      removeLoadingBubble();\n\n      if (data.messageType === 'analysis') {\n        analysisContext = data.analysisContext;\n        renderAnalysis(data.analysisContext);\n        hintEl.textContent = 'Análise concluída · Pergunte para aprofundar os insights';\n      } else {\n        addAssistantBubble(data.message ?? '');\n      }\n\n      const assistantContent = data.messageType === 'analysis'\n        ? `[Análise completa de ${data.analysisContext?.url_analisada} sobre ${data.analysisContext?.topico}]`\n        : (data.message ?? '');\n      history.push({ role: 'user', content: text });\n      history.push({ role: 'assistant', content: assistantContent });\n\n    } catch (err) {\n      removeLoadingBubble();\n      setStatus(false);\n      addAssistantBubble(`❌ Erro: ${err.message}. Verifique a conexão e tente novamente.`);\n      setTimeout(() => setStatus(true), 4000);\n    }\n\n    busy = false;\n    sbtn.disabled = false;\n    inp.focus();\n  }\n</script>\n</body>\n</html>\n",
        "options": {
          "responseHeaders": {
            "entries": [
              {
