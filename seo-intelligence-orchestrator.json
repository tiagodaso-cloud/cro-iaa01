      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const fanout = $('Query Fan-out v2').first()?.json ?? {};\nconst geo    = $('Prompt Mapper GEO').first()?.json ?? {};\nconst onPage = $('On-Page SEO Audit').first()?.json ?? {};\nconst cwv    = $('CorePulse CWV').first()?.json ?? {};\nconst params = $('Extrair URL e Tópico').first()?.json ?? {};\n\nconst context = {\n  url_analisada: params.url,\n  topico: params.topic,\n  query_fanout: {\n    fanout_queries:   fanout.fanout_queries   ?? {},\n    cited_sources:    fanout.cited_sources    ?? {},\n    source_diversity: fanout.source_diversity ?? {},\n    seo_summary:      fanout.seo_summary      ?? {}\n  },\n  geo_mapping: {\n    summary:       geo.summary ?? '',\n    total_prompts: geo.total   ?? 0,\n    prompts:       (geo.prompts ?? []).slice(0, 10)\n  },\n  on_page_audit: onPage,\n  cwv_status: cwv.status ?? 'dispatched',\n  cwv_nota: 'Relatório CWV completo enviado por e-mail pelo CorePulse Analyzer (assíncrono).'\n};\n\nreturn [{ json: { correlationContext: JSON.stringify(context, null, 2) } }];"
