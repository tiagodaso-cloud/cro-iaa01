        "jsCode": "const raw = ($input.first()?.json?.output ?? '').trim();\nconst cleaned = raw.replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/i, '').trim();\nlet analysisData;\ntry { analysisData = JSON.parse(cleaned); }\ncatch(e) {\n  analysisData = {\n    sumario: { insights: [raw.slice(0,500) || 'Análise indisponível.'], nivel_impacto: 'Médio' },\n    correlacoes: [], gaps_oportunidades: [], plano_acao: [], proximos_passos: []\n  };\n}\nconst params = $('Extrair URL e Tópico').first()?.json ?? {};\nconst cwv    = $('CorePulse CWV').first()?.json ?? {};\nconst analysisContext = {\n  ...analysisData,\n  url_analisada: params.url,\n  topico: params.topic,\n  cwv_status: cwv.status ?? 'dispatched',\n  cwv_email_enviado: (cwv.status ?? '') === 'received',\n  generated_at: new Date().toISOString()\n};\nreturn [{ json: { role: 'assistant', messageType: 'analysis', message: null, analysisContext } }];"
