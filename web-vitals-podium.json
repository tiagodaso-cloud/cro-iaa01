      "id": "daabf5a0-1b13-40a8-9492-3917498feb23",
      "name": "POST – Analisar",
      "webhookId": "a75b4b08-8452-4766-88ef-b8fa17a959a6"
    },
    {
      "parameters": {
        "jsCode": "\n// ============================================================================\n// Web Vitals Leaderboard — coleta PageSpeed Insights (CrUX + Lighthouse)\n// para varias URLs em mobile e desktop, classifica por Core Web Vitals\n// e monta o ranking. Roda \"Once for All Items\".\n// ============================================================================\n\n// ---- CONFIG -----------------------------------------------------------------\nconst API_KEY = '';                 // (opcional) cole sua Google PageSpeed API key p/ maior quota\nconst STRATEGIES = ['mobile', 'desktop'];\nconst MAX_URLS = 8;                 // trava de seguranca\nconst PSI = 'https://www.googleapis.com/pagespeedonline/v5/runPagespeed';\n// -----------------------------------------------------------------------------\n\nconst H = this.helpers;\n\n// entrada: body.urls (array) OU string (uma por linha / virgula)\nconst raw = $input.first()?.json ?? {};\nconst body = raw.body ?? raw;\nlet urls = body.urls ?? body.url ?? [];\nif (typeof urls === 'string') urls = urls.split(/[\\n,;]+/);\nurls = (Array.isArray(urls) ? urls : [urls])\n  .map(u => String(u || '').trim())\n  .filter(Boolean)\n  .map(u => /^https?:\\/\\//i.test(u) ? u : 'https://' + u);\nurls = [...new Set(urls)].slice(0, MAX_URLS);\n\n// limiares oficiais Core Web Vitals: [good, needs-improvement]\nconst TH = { fcp: [1800, 3000], lcp: [2500, 4000], cls: [0.10, 0.25], inp: [200, 500] };\nfunction cat(metric, v) {\n  if (v == null || Number.isNaN(v)) return 'na';\n  const t = TH[metric];\n  if (v <= t[0]) return 'good';\n  if (v <= t[1]) return 'ni';\n  return 'poor';\n}\nfunction host(u) { try { return new URL(u).hostname.replace(/^www\\./, ''); } catch { return u; } }\nfunction decode(s) {\n  return s.replace(/&amp;/g, '&').replace(/&#0?39;/g, \"'\").replace(/&#x27;/gi, \"'\")\n          .replace(/&quot;/g, '\"').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&nbsp;/g, ' ');\n}\n\n// busca titulo <title> da pagina + favicon embutido (data URI) — 1x por dominio\nasync function siteMeta(url) {\n  const h = host(url);\n  let title = h, favicon = '';\n  try {\n    const html = await H.httpRequest({\n      url, timeout: 15000,\n      headers: { 'User-Agent': 'Mozilla/5.0 (compatible; WebVitalsPodium/1.0)' },\n    });\n    const m = /<title[^>]*>([\\s\\S]*?)<\\/title>/i.exec(String(html));\n    if (m && m[1].trim()) title = decode(m[1].trim().replace(/\\s+/g, ' ')).slice(0, 90);\n  } catch (e) {}\n  try {\n    const buf = await H.httpRequest({\n      url: 'https://www.google.com/s2/favicons?domain=' + h + '&sz=64',\n      encoding: 'arraybuffer', timeout: 15000,\n    });\n    favicon = 'data:image/png;base64,' + Buffer.from(buf).toString('base64');\n  } catch (e) {}\n  return { host: h, title, favicon };\n}\n\nasync function analyze(url, strategy, meta) {\n  try {\n    const qs = { url, strategy, category: 'performance' };\n    if (API_KEY) qs.key = API_KEY;\n    const psi = await H.httpRequest({ url: PSI, qs, json: true, timeout: 60000 });\n\n    const lhr = psi.lighthouseResult ?? {};\n    const aud = lhr.audits ?? {};\n    const le  = psi.loadingExperience ?? {};\n    const met = le.metrics ?? {};\n\n    const perf = lhr.categories?.performance?.score;\n\n    // 1) campo (CrUX / dados reais de usuarios) — preferencial\n    const fFcp = met.FIRST_CONTENTFUL_PAINT_MS?.percentile;\n    const fLcp = met.LARGEST_CONTENTFUL_PAINT_MS?.percentile;\n    const fCls = met.CUMULATIVE_LAYOUT_SHIFT_SCORE?.percentile;\n    const fInp = met.INTERACTION_TO_NEXT_PAINT?.percentile;\n\n    // 2) laboratorio (Lighthouse) — fallback quando nao ha dados de campo\n    const lFcp = aud['first-contentful-paint']?.numericValue;\n    const lLcp = aud['largest-contentful-paint']?.numericValue;\n    const lCls = aud['cumulative-layout-shift']?.numericValue;\n\n    const hasField = fLcp != null || fFcp != null;\n    const fcp = fFcp != null ? fFcp : lFcp;                       // ms\n    const lcp = fLcp != null ? fLcp : lLcp;                       // ms\n    const cls = fCls != null ? fCls / 100 : lCls;                // score\n    const inp = fInp != null ? fInp : null;                       // ms (so campo)\n\n    const fmtS  = v => v == null ? '—' : (v / 1000).toFixed(2) + 's';\n    const fmtMs = v => v == null ? '—' : Math.round(v) + 'ms';\n    const fmtN  = v => v == null ? '—' : v.toFixed(2);\n\n    return {\n      ok: true, url, host: meta.host, title: meta.title, favicon: meta.favicon, strategy,\n      perf: perf != null ? Math.round(perf * 100) : null,\n      source: hasField ? 'field' : 'lab',\n      fcp: { v: fmtS(fcp),  cat: cat('fcp', fcp) },\n      lcp: { v: fmtS(lcp),  cat: cat('lcp', lcp) },\n      cls: { v: fmtN(cls),  cat: cat('cls', cls) },\n      inp: { v: fmtMs(inp), cat: cat('inp', inp) },\n    };\n  } catch (e) {\n    return {\n      ok: false, url, host: meta.host, title: meta.title, favicon: meta.favicon, strategy, perf: null, source: 'error',\n      error: String(e.message || e).slice(0, 160),\n      fcp: { v: '—', cat: 'na' }, lcp: { v: '—', cat: 'na' },\n      cls: { v: '—', cat: 'na' }, inp: { v: '—', cat: 'na' },\n    };\n  }\n}\n\n// 1) metadados (titulo + favicon embutido) por url, em paralelo\nconst metaList = await Promise.all(urls.map(u => siteMeta(u)));\nconst metaMap = {};\nurls.forEach((u, i) => { metaMap[u] = metaList[i]; });\n\n// 2) PageSpeed por (url x estrategia), em paralelo\nconst jobs = [];\nfor (const u of urls) for (const s of STRATEGIES) jobs.push(analyze(u, s, metaMap[u]));\nconst all = await Promise.all(jobs);\n\n// agrupa por estrategia e ranqueia por performance score (desc)\nconst out = {};\nfor (const s of STRATEGIES) {\n  const rows = all.filter(r => r.strategy === s)\n    .sort((a, b) => (b.perf ?? -1) - (a.perf ?? -1));\n  rows.forEach((r, i) => { r.rank = r.perf == null ? null : i + 1; });\n  out[s] = rows;\n}\n\nreturn [{ json: {\n  generatedAt: new Date().toISOString(),\n  count: urls.length,\n  strategies: out,\n} }];\n"
      },
