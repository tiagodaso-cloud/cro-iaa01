        "responseBody": "<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n<meta charset=\"UTF-8\"/>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\n<title>Web Vitals Podium</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\"/>\n<script src=\"https://cdn.jsdelivr.net/npm/html-to-image@1.11.11/dist/html-to-image.js\"></script>\n<style>\n:root{--ox:#FF5C28;--ox2:#e84e1b;--dark:#111827;--card:#1f2937;--border:#374151;--text:#f9fafb;--muted:#9ca3af;--green:#10b981;--yellow:#f59e0b;--red:#ef4444}\n*{box-sizing:border-box;margin:0;padding:0}\nbody{font-family:'Plus Jakarta Sans',sans-serif;background:var(--dark);color:var(--text);min-height:100vh}\nheader{background:rgba(17,24,39,.95);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);padding:0 24px;height:60px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100}\n.hbrand{display:flex;align-items:center;gap:12px}\n.logo{width:30px;height:30px;background:linear-gradient(135deg,var(--ox2),var(--ox));border-radius:7px;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:14px;color:#fff}\n.btext{font-size:15px;font-weight:700}.btext span{color:var(--ox)}\n.hub-badge{background:linear-gradient(135deg,#6d28d9,#8b5cf6);color:#fff;font-size:10px;font-weight:700;padding:3px 9px;border-radius:20px;letter-spacing:.5px;text-transform:uppercase}\n.hmeta{display:flex;align-items:center;gap:8px}\n.sdot{width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 6px var(--green)}\n.stext{font-size:12px;color:var(--muted)}\n.wrap{max-width:1080px;margin:0 auto;padding:40px 24px 60px}\n.hero{text-align:center;margin-bottom:32px}\n.eyebrow{font-size:13px;font-weight:600;color:var(--muted);letter-spacing:.5px;margin-bottom:10px}\n.hero h1{font-size:44px;font-weight:800;line-height:1.1;margin-bottom:14px}\n.hero h1 span{color:var(--ox)}\n.hero p{font-size:15px;color:var(--muted);max-width:560px;margin:0 auto;line-height:1.6}\n.inputbar{display:flex;gap:10px;max-width:640px;margin:28px auto 0}\n.inputbar input{flex:1;background:var(--card);border:1px solid var(--border);border-radius:12px;padding:14px 18px;color:var(--text);font-family:inherit;font-size:14px;outline:none;transition:border-color .15s}\n.inputbar input:focus{border-color:var(--ox)}\n.btn{border:none;border-radius:12px;padding:14px 22px;font-family:inherit;font-size:14px;font-weight:700;cursor:pointer;transition:transform .1s,opacity .15s}\n.btn:active{transform:scale(.97)}\n.btn-primary{background:linear-gradient(135deg,var(--ox2),var(--ox));color:#fff}\n.btn-ghost{background:var(--card);border:1px solid var(--border);color:var(--muted)}\n.chips{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;max-width:720px;margin:18px auto 0}\n.chip{display:flex;align-items:center;gap:8px;background:rgba(255,92,40,.08);border:1px solid rgba(255,92,40,.3);border-radius:20px;padding:6px 8px 6px 12px;font-size:13px;color:var(--text)}\n.chip img{width:16px;height:16px;border-radius:3px}\n.chip b{cursor:pointer;color:var(--muted);font-weight:700;padding:0 4px;line-height:1}\n.chip b:hover{color:var(--red)}\n.actions{display:flex;gap:10px;justify-content:center;margin-top:24px}\n.hint{font-size:12px;color:var(--muted);text-align:center;margin-top:14px}\n.hint a{color:var(--ox);cursor:pointer;text-decoration:none}\n.panel{background:#fff;border-radius:18px;margin-top:36px;padding:22px;color:#111827;display:none}\n.ptop{display:flex;align-items:center;justify-content:center;gap:14px;margin-bottom:18px;flex-wrap:wrap}\n.dlbtn{background:linear-gradient(135deg,var(--ox2),var(--ox));color:#fff;border:none;border-radius:10px;padding:9px 16px;font-family:inherit;font-size:13px;font-weight:700;cursor:pointer;transition:transform .1s}\n.dlbtn:active{transform:scale(.96)}\n.dlbtn:disabled{opacity:.5;cursor:not-allowed}\n.caphead{display:flex;align-items:center;gap:12px;margin-bottom:12px}\n.caplogo{width:32px;height:32px;background:linear-gradient(135deg,var(--ox2),var(--ox));border-radius:8px;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:15px;flex-shrink:0}\n.captitle{font-size:18px;font-weight:800;color:#111827;line-height:1.2}.captitle span{color:var(--ox)}\n.capsub{font-size:11px;color:#6b7280;font-weight:700;text-transform:uppercase;letter-spacing:.4px}\n#capture{background:#fff;padding:6px 2px 2px}\n.toggle{display:inline-flex;background:#f3f4f6;border-radius:10px;padding:4px}\n.toggle button{border:none;background:none;padding:8px 20px;border-radius:8px;font-family:inherit;font-size:13px;font-weight:700;color:#6b7280;cursor:pointer}\n.toggle button.on{background:#fff;color:#111827;box-shadow:0 1px 3px rgba(0,0,0,.12)}\n.stamp{font-size:12px;color:#9ca3af;text-align:center;margin-bottom:14px}\ntable{width:100%;border-collapse:separate;border-spacing:0 6px}\nthead th{font-size:11px;font-weight:700;color:#9ca3af;text-transform:uppercase;letter-spacing:.5px;padding:0 10px 6px;text-align:center}\nthead th.l{text-align:left}\ntbody td{padding:14px 10px;background:#f9fafb;text-align:center;font-size:14px;font-weight:600}\ntbody td:first-child{border-radius:12px 0 0 12px}\ntbody td:last-child{border-radius:0 12px 12px 0}\n.rank{font-size:16px;font-weight:800;color:#6b7280;width:60px}\n.site{text-align:left}\n.site .row{display:flex;align-items:center;gap:12px}\n.site img{width:30px;height:30px;border-radius:7px;background:#eee;flex-shrink:0}\n.site .nm{font-size:14px;font-weight:800;color:#111827;letter-spacing:.1px;line-height:1.25}\n.site .u{font-size:12px;font-weight:500;color:#6b7280}\n.site .u a{color:#6b7280;text-decoration:none}\n.perf{font-weight:800}\n.badge{display:inline-block;font-size:10px;font-weight:700;padding:2px 8px;border-radius:20px;margin-left:6px;vertical-align:middle}\n.badge.field{background:#e0e7ff;color:#4338ca}\n.badge.lab{background:#fef3c7;color:#92400e}\n.cell{border-radius:8px}\n.good{background:#a7f3d0;color:#065f46}\n.ni{background:#fde68a;color:#92400e}\n.poor{background:#fca5a5;color:#7f1d1d}\n.na{background:#e5e7eb;color:#9ca3af}\n.loading{display:none;text-align:center;padding:60px 0;color:var(--muted)}\n.spin{width:38px;height:38px;border:3px solid var(--border);border-top-color:var(--ox);border-radius:50%;margin:0 auto 16px;animation:sp 1s linear infinite}\n@keyframes sp{to{transform:rotate(360deg)}}\n.err{color:var(--red);font-size:12px}\n.foot{text-align:center;color:var(--muted);font-size:12px;margin-top:28px}\n@media(max-width:640px){.hero h1{font-size:32px}.inputbar{flex-direction:column}.site .u{display:none}}\n</style>\n</head>\n<body>\n<header>\n  <div class=\"hbrand\">\n    <div class=\"logo\">C</div>\n    <span class=\"btext\">Web <span>Vitals</span></span>\n    <span class=\"hub-badge\">Podium</span>\n  </div>\n  <div class=\"hmeta\"><div class=\"sdot\"></div><span class=\"stext\">Online</span></div>\n</header>\n\n<div class=\"wrap\">\n  <div class=\"hero\">\n    <div class=\"eyebrow\">Compare sua velocidade contra os concorrentes</div>\n    <h1>Web Vitals <span>Podium</span></h1>\n    <p>A forma mais simples de entender como a performance do seu site se compara a outros do seu segmento. PageSpeed + Core Web Vitals (FCP, LCP, CLS, INP).</p>\n    <div class=\"inputbar\">\n      <input id=\"url\" type=\"text\" placeholder=\"Cole a URL de uma pagina ou dominio (https://)\" autocomplete=\"off\"/>\n      <button class=\"btn btn-primary\" onclick=\"add()\">ADICIONAR</button>\n    </div>\n    <div class=\"chips\" id=\"chips\"></div>\n    <div class=\"actions\">\n      <button class=\"btn btn-primary\" onclick=\"run()\">⚡ ANALISAR</button>\n      <button class=\"btn btn-ghost\" onclick=\"reset()\">LIMPAR</button>\n    </div>\n    <div class=\"hint\">Sem ideias? Carregue os <a onclick=\"demo()\">exemplos de e-commerce</a>.</div>\n  </div>\n\n  <div class=\"loading\" id=\"loading\"><div class=\"spin\"></div>Consultando o Google PageSpeed Insights… isso pode levar alguns segundos.</div>\n\n  <div class=\"panel\" id=\"panel\">\n    <div class=\"ptop\">\n      <div class=\"toggle\">\n        <button id=\"tm\" class=\"on\" onclick=\"show('mobile')\">MOBILE</button>\n        <button id=\"td\" onclick=\"show('desktop')\">DESKTOP</button>\n      </div>\n      <button class=\"dlbtn\" id=\"dl\" onclick=\"downloadPng()\">⬇ Baixar PNG</button>\n    </div>\n    <div id=\"capture\">\n      <div class=\"caphead\">\n        <div class=\"caplogo\">C</div>\n        <div>\n          <div class=\"captitle\">Web Vitals <span>Podium</span></div>\n          <div class=\"capsub\" id=\"capsub\"></div>\n        </div>\n      </div>\n      <div class=\"stamp\" id=\"stamp\"></div>\n      <div style=\"overflow-x:auto\">\n        <table>\n          <thead><tr>\n            <th>Rank</th><th class=\"l\">Site</th><th>Perf</th><th>FCP</th><th>LCP</th><th>CLS</th><th>INP</th>\n          </tr></thead>\n          <tbody id=\"tbody\"></tbody>\n        </table>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"foot\">Powered by Google PageSpeed Insights · Design System Cadastra</div>\n</div>\n\n<script>\nvar RUN_URL = location.href.split('?')[0].replace(/web-vitals\\/?$/, 'web-vitals-run');\nvar urls = [];\nvar data = null, cur = 'mobile';\nvar DEMO = ['https://www.tokstok.com.br/','https://www.leroymerlin.com.br/','https://www.madesa.com/','https://www.madeiramadeira.com.br/'];\n\nfunction fav(h){ return 'https://www.google.com/s2/favicons?domain='+h+'&sz=64'; }\nfunction norm(u){ u=(u||'').trim(); if(!u) return ''; if(!/^https?:\\/\\//i.test(u)) u='https://'+u; return u; }\n\nfunction renderChips(){\n  var c=document.getElementById('chips'); c.innerHTML='';\n  urls.forEach(function(u,i){\n    var h; try{h=new URL(u).hostname.replace(/^www\\./,'');}catch(e){h=u;}\n    var el=document.createElement('div'); el.className='chip';\n    el.innerHTML='<img src=\"'+fav(h)+'\"/><span>'+h+'</span><b onclick=\"rm('+i+')\">×</b>';\n    c.appendChild(el);\n  });\n}\nfunction add(){\n  var i=document.getElementById('url'); var u=norm(i.value);\n  if(u && urls.indexOf(u)<0){ urls.push(u); renderChips(); }\n  i.value=''; i.focus();\n}\nfunction rm(i){ urls.splice(i,1); renderChips(); }\nfunction demo(){ urls=DEMO.slice(); renderChips(); }\nfunction reset(){ urls=[]; data=null; renderChips(); document.getElementById('panel').style.display='none'; }\ndocument.getElementById('url').addEventListener('keydown',function(e){ if(e.key==='Enter') add(); });\n\nfunction run(){\n  if(!urls.length){ alert('Adicione ao menos uma URL.'); return; }\n  document.getElementById('panel').style.display='none';\n  document.getElementById('loading').style.display='block';\n  fetch(RUN_URL,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({urls:urls})})\n    .then(function(r){return r.json();})\n    .then(function(j){ data=j; document.getElementById('loading').style.display='none'; show(cur); })\n    .catch(function(e){ document.getElementById('loading').innerHTML='<span class=\"err\">Falha ao analisar: '+e+'</span>'; });\n}\n\nfunction medal(r){ return r===1?'🥇':r===2?'🥈':r===3?'🥉':(r==null?'—':r); }\nfunction cellCls(c){ return c==='good'?'good':c==='ni'?'ni':c==='poor'?'poor':'na'; }\nfunction esc(s){ var d=document.createElement('div'); d.textContent=s==null?'':String(s); return d.innerHTML; }\n\nfunction show(strat){\n  cur=strat;\n  document.getElementById('tm').className = strat==='mobile'?'on':'';\n  document.getElementById('td').className = strat==='desktop'?'on':'';\n  if(!data) return;\n  var rows=(data.strategies&&data.strategies[strat])||[];\n  document.getElementById('capsub').textContent = strat.toUpperCase()+' · Comparativo Core Web Vitals';\n  var stamp=document.getElementById('stamp');\n  var dt=data.generatedAt?new Date(data.generatedAt).toLocaleString('pt-BR'):'';\n  stamp.textContent='Analisado em '+dt+' · '+rows.length+' site(s)';\n  var tb=document.getElementById('tbody'); tb.innerHTML='';\n  rows.forEach(function(r){\n    var tr=document.createElement('tr');\n    var badge=r.source==='field'?'<span class=\"badge field\">campo</span>':(r.source==='lab'?'<span class=\"badge lab\">lab</span>':'');\n    tr.innerHTML=\n      '<td class=\"rank\">'+medal(r.rank)+'</td>'+\n      '<td class=\"site\"><div class=\"row\"><img src=\"'+(r.favicon||fav(r.host))+'\"/><div>'+\n        '<div class=\"nm\">'+esc(r.title||r.host)+badge+'</div>'+\n        '<div class=\"u\"><a href=\"'+r.url+'\" target=\"_blank\">'+esc(r.host)+'</a></div></div></div></td>'+\n      '<td class=\"perf\">'+(r.perf==null?'—':r.perf)+'</td>'+\n      '<td class=\"cell '+cellCls(r.fcp.cat)+'\">'+r.fcp.v+'</td>'+\n      '<td class=\"cell '+cellCls(r.lcp.cat)+'\">'+r.lcp.v+'</td>'+\n      '<td class=\"cell '+cellCls(r.cls.cat)+'\">'+r.cls.v+'</td>'+\n      '<td class=\"cell '+cellCls(r.inp.cat)+'\">'+r.inp.v+'</td>';\n    tb.appendChild(tr);\n  });\n  document.getElementById('panel').style.display='block';\n}\n\nfunction downloadPng(){\n  if(!data){ return; }\n  if(typeof htmlToImage==='undefined'){ alert('Biblioteca de captura nao carregou. Verifique a conexao e recarregue a pagina.'); return; }\n  var btn=document.getElementById('dl'); var lbl=btn.textContent;\n  btn.disabled=true; btn.textContent='Gerando…';\n  htmlToImage.toPng(document.getElementById('capture'),{backgroundColor:'#ffffff',pixelRatio:2,skipFonts:true,cacheBust:true})\n    .then(function(dataUrl){\n      var link=document.createElement('a');\n      link.download='web-vitals-podium-'+cur+'-'+new Date().toISOString().slice(0,10)+'.png';\n      link.href=dataUrl;\n      link.click();\n      btn.disabled=false; btn.textContent=lbl;\n    })\n    .catch(function(e){ alert('Nao foi possivel gerar a imagem: '+e); btn.disabled=false; btn.textContent=lbl; });\n}\n</script>\n</body>\n</html>",
