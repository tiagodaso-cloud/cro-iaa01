            "index": 0
          }
        ]
      ]
    },
    "Dividir Texto": {
      "ai_textSplitter": [
        [
          {
            "node": "Carregar Documento",
            "type": "ai_textSplitter",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  }
