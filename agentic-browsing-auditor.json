      "id": "ab000006-0000-0000-0000-000000000006",
      "name": "Fetch Page HTML",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        304,
        240
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const data = $input.item.json.data ?? '';\nconst statusCode = $input.item.json.statusCode ?? 0;\n\nconst indicators = [\n  { re: /PerimeterX|_pxParam|px-captcha|pxCaptcha|_px\\b/, name: 'PerimeterX' },\n  { re: /cf_chl_|cf-browser-verification|__cf_chl_|Just a moment\\.\\.\\.|Enable JavaScript and cookies to continue/, name: 'Cloudflare Challenge' },\n  { re: /DataDome|datadome\\.co/, name: 'DataDome' },\n  { re: /incapsula|visid_incap|reese84/, name: 'Imperva/Incapsula' },\n  { re: /AkamaiGHost|akamai_bot/, name: 'Akamai Bot Manager' },\n  { re: /human\\.security|shape\\.service|f5bot/, name: 'F5/Shape Security' },\n  { re: /verifyHuman|Are you a human|robot check|robotcheck|Pardon Our Interruption/, name: 'Generic Bot Check' }\n];\n\nlet blockType = null;\nfor (const ind of indicators) {\n  if (ind.re.test(data)) { blockType = ind.name; break; }\n}\n\nconst isRealHtml = /<html|<body|<!DOCTYPE/i.test(data);\nconst isJsonBlob = /^\\s*[\\{\\[]/.test(data) && !data.includes('<');\nconst isTiny = data.trim().length < 800 && !isRealHtml;\nconst isBlocked = !!blockType || isJsonBlob || isTiny;\nconst effectiveBlockType = blockType || (isBlocked ? 'Página bloqueada ou resposta inválida' : null);\n\nreturn [{ json: {\n  ...($input.item.json),\n  is_bot_blocked: isBlocked,\n  block_type: effectiveBlockType,\n  html_length: data.length,\n  is_real_html: isRealHtml\n}}];"
      },
      "id": "ab000013-0000-0000-0000-000000000013",
      "name": "Detectar Bloqueio",
