        "respondWith": "text",
        "responseBody": "<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n  <meta charset=\"UTF-8\"/>\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\n  <title>Agentic Browsing Auditor | Cadastra</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n  <link rel=\"icon\" type=\"image/png\" href=\"https://creativosbr.com.br/wp-content/uploads/2022/08/cadastra-1638546176-logopng.png\">\n  <style>\n    *,*::before,*::after{margin:0;padding:0;box-sizing:border-box}\n    :root{--ox:#FF5C28;--ox-light:#fff3ee;--ox-border:#ffd0bc;--dark:#111827;--gray:#6b7280;--gray-light:#9ca3af;--bg:#f4f4f2;--white:#ffffff;--line:#e5e7eb;--line-soft:#f3f4f6;--green:#059669;--green-bg:#ecfdf5;--green-border:#a7f3d0;--blue:#2563eb;--blue-bg:#eff6ff;--blue-border:#bfdbfe;--yellow:#d97706;--yellow-bg:#fffbeb;--yellow-border:#fde68a;--red:#dc2626;--red-bg:#fef2f2;--red-border:#fecaca;--purple:#7c3aed;--purple-bg:#f5f3ff;--purple-border:#ddd6fe;--slate:#64748b;--slate-bg:#f1f5f9;--slate-border:#cbd5e1;--sans:'Plus Jakarta Sans',sans-serif;--mono:'JetBrains Mono',monospace;--r:12px;--r-lg:16px;--shadow:0 1px 3px rgba(0,0,0,.08),0 4px 16px rgba(0,0,0,.06);--shadow-lg:0 4px 24px rgba(0,0,0,.08),0 12px 48px rgba(0,0,0,.06)}\n    body{font-family:var(--sans);background:var(--bg);color:var(--dark);line-height:1.6;min-height:100vh}\n    .header{background:var(--white);padding:0 40px;height:56px;display:flex;align-items:center;box-shadow:0 1px 0 var(--line);position:sticky;top:0;z-index:200}\n    .header-inner{max-width:1100px;margin:0 auto;width:100%;display:flex;align-items:center;gap:12px}\n    .logo{height:26px}.product-name{font-size:16px;font-weight:800;letter-spacing:-.02em}\n    .product-name span{color:var(--ox)}.version-badge{background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#fff;padding:3px 10px;border-radius:999px;font-size:10px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}\n    .hero{background:linear-gradient(140deg,#e84e1b 0%,#ff6b3d 100%);padding:40px 40px 88px;position:relative;overflow:hidden}\n    .hero::after{content:'';position:absolute;bottom:0;left:0;right:0;height:72px;background:linear-gradient(to bottom,transparent,var(--bg))}\n    .hero-inner{max-width:1100px;margin:0 auto;position:relative;z-index:1;color:#fff}\n    .hero-eyebrow{font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;opacity:.75;margin-bottom:10px}\n    .hero h1{font-size:clamp(28px,4vw,44px);font-weight:800;letter-spacing:-.03em;line-height:1.1;margin-bottom:12px}\n    .hero-desc{font-size:16px;max-width:580px;opacity:.9;line-height:1.6;margin-bottom:24px}\n    .hero-badges{display:flex;gap:8px;flex-wrap:wrap}\n    .hero-badge{background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.25);color:rgba(255,255,255,.92);padding:4px 12px;border-radius:999px;font-size:11px;font-weight:600}\n    .wrap{max-width:1100px;margin:-48px auto 60px;padding:0 40px;position:relative;z-index:10}\n    .card{background:var(--white);border-radius:var(--r-lg);box-shadow:var(--shadow-lg);padding:40px 44px;margin-bottom:24px}\n    .card-title{font-size:20px;font-weight:800;letter-spacing:-.02em;margin-bottom:4px}\n    .card-sub{color:var(--gray);margin-bottom:28px;font-size:14px;line-height:1.6}\n    .form-label{font-weight:700;font-size:13px;text-transform:uppercase;letter-spacing:.06em;color:var(--gray);margin-bottom:8px;display:block}\n    .form-group{margin-bottom:20px}\n    .q-input{width:100%;padding:14px 18px;border:2px solid var(--line);border-radius:var(--r);font-size:15px;font-family:var(--sans);color:var(--dark);outline:none;background:var(--white);transition:border-color .2s,box-shadow .2s}\n    .q-input::placeholder{color:var(--gray-light)}\n    .q-input:focus{border-color:var(--ox);box-shadow:0 0 0 4px rgba(255,92,40,.1)}\n    textarea.q-input{resize:vertical;min-height:80px}\n    .input-row{display:flex;gap:10px;align-items:stretch}.input-row .q-input{flex:1}\n    .run-btn{background:linear-gradient(145deg,#ff6535,var(--ox));color:#fff;border:none;padding:14px 32px;border-radius:var(--r);font-size:15px;font-weight:800;font-family:var(--sans);cursor:pointer;white-space:nowrap;box-shadow:0 4px 16px rgba(255,92,40,.4);transition:transform .15s,box-shadow .15s;letter-spacing:-.01em}\n    .run-btn:hover:not(:disabled){transform:translateY(-2px);box-shadow:0 8px 24px rgba(255,92,40,.45)}.run-btn:disabled{opacity:.5;cursor:not-allowed;transform:none}\n    .features-box{background:var(--line-soft);border:1px solid var(--line);border-radius:var(--r);padding:22px 24px;margin-top:24px}\n    .features-box h3{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:var(--gray-light);margin-bottom:16px}\n    .feat-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:10px}\n    .feat-item{display:flex;align-items:flex-start;gap:10px;padding:8px 10px;background:var(--white);border:1px solid var(--line);border-radius:8px;font-size:13px;font-weight:500;line-height:1.4}\n    .feat-check{width:20px;height:20px;background:var(--ox);border-radius:50%;color:#fff;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:800;flex-shrink:0;margin-top:1px}\n    .feat-code{font-family:var(--mono);font-size:11px;background:#1e1e2e;color:#cba6f7;padding:1px 6px;border-radius:3px;font-weight:500}\n    .loading{display:none;background:var(--white);border-radius:var(--r-lg);box-shadow:var(--shadow);padding:40px;margin-bottom:24px;text-align:center}.loading.on{display:block}\n    .spinner{width:40px;height:40px;margin:0 auto 18px;border:3px solid rgba(255,92,40,.12);border-top-color:var(--ox);border-radius:50%;animation:spin .8s linear infinite}\n    @keyframes spin{to{transform:rotate(360deg)}}\n    .loading-title{font-weight:700;font-size:15px;margin-bottom:4px}.loading-sub{font-size:13px;color:var(--gray);margin-bottom:20px}\n    .timer-wrap{margin:0 auto 24px;max-width:340px}.timer-bar-bg{height:6px;background:var(--line);border-radius:3px;overflow:hidden}\n    .timer-bar-fill{height:100%;border-radius:3px;background:linear-gradient(90deg,var(--ox),#ff7a50);width:0%;transition:width .5s linear}\n    .timer-label{font-size:11px;color:var(--gray-light);margin-top:6px;font-family:var(--mono)}\n    .err-box{display:none;background:var(--red-bg);border:2px solid var(--red-border);border-radius:var(--r);padding:20px 24px;margin-bottom:16px}.err-box.on{display:block}\n    .err-box h4{color:var(--red);font-weight:800;margin-bottom:6px}.err-box p{color:#7f1d1d;font-size:14px}\n    .results{display:none}.results.on{display:block}\n    .infra-alert{background:#fff1f2;border:2px solid #fda4af;border-radius:var(--r);padding:20px 24px;margin-bottom:16px}\n    .infra-alert-head{display:flex;align-items:center;gap:8px;font-size:14px;font-weight:800;color:#be123c;margin-bottom:10px}\n    .infra-alert-body{font-size:13px;color:#881337;margin-bottom:6px}\n    .infra-alert-geo{font-size:12px;background:#ffe4e6;border-radius:6px;padding:6px 10px;color:#9f1239;margin-bottom:8px}\n    .infra-alert-rec{font-size:12px;font-style:italic;color:var(--dark)}\n    .section{background:var(--white);border:1px solid var(--line);border-radius:var(--r-lg);margin-bottom:16px;overflow:hidden;box-shadow:0 1px 3px rgba(0,0,0,.07)}\n    .section-head{padding:16px 22px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;cursor:pointer;user-select:none}\n    .section-head:hover{background:var(--line-soft)}.section-title{font-size:14px;font-weight:800;letter-spacing:-.01em}\n    .section-body{padding:22px}.section-body.hidden{display:none}\n    .kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;margin-bottom:20px}\n    .kpi{background:var(--line-soft);border:1px solid var(--line);border-radius:var(--r);padding:16px;text-align:center;border-top:3px solid var(--ox)}\n    .kpi-val{font-size:24px;font-weight:800;letter-spacing:-.04em;color:var(--dark);line-height:1;margin-bottom:4px}\n    .kpi-lbl{font-size:11px;font-weight:700;color:var(--gray);text-transform:uppercase;letter-spacing:.06em}\n    .score-frac{font-size:2em;font-weight:800;letter-spacing:-.04em;line-height:1}\n    .score-frac.hi{color:var(--green)}.score-frac.mid{color:var(--yellow)}.score-frac.lo{color:var(--red)}\n    .geo-badge{display:inline-block;font-size:12px;font-weight:700;padding:3px 12px;border-radius:999px}\n    .geo-badge.poor{background:var(--red-bg);color:var(--red);border:1px solid var(--red-border)}\n    .geo-badge.fair{background:var(--yellow-bg);color:var(--yellow);border:1px solid var(--yellow-border)}\n    .geo-badge.good{background:var(--green-bg);color:var(--green);border:1px solid var(--green-border)}\n    .geo-badge.excellent{background:var(--purple-bg);color:var(--purple);border:1px solid var(--purple-border)}\n    .audit-item{border-left:4px solid var(--line);padding:12px 16px;margin:8px 0;background:var(--line-soft);border-radius:0 var(--r) var(--r) 0}\n    .audit-item.pass{border-left-color:var(--green)}.audit-item.fail{border-left-color:var(--red)}.audit-item.warning{border-left-color:var(--yellow)}.audit-item.indeterminate{border-left-color:var(--slate)}\n    .audit-head{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-bottom:6px}\n    .audit-id{font-family:var(--mono);font-size:11px;background:#1e1e2e;color:#cba6f7;padding:2px 8px;border-radius:4px}\n    .st-badge{font-size:10px;font-weight:700;padding:2px 8px;border-radius:4px;text-transform:uppercase}\n    .st-badge.pass{background:var(--green-bg);color:var(--green);border:1px solid var(--green-border)}\n    .st-badge.fail{background:var(--red-bg);color:var(--red);border:1px solid var(--red-border)}\n    .st-badge.warning{background:var(--yellow-bg);color:var(--yellow);border:1px solid var(--yellow-border)}\n    .st-badge.indeterminate{background:var(--slate-bg);color:var(--slate);border:1px solid var(--slate-border)}\n    .impact-tag{font-size:10px;font-weight:600;padding:2px 6px;border-radius:3px;text-transform:uppercase;letter-spacing:.04em}\n    .impact-tag.critical{background:#fde8e8;color:#c81e1e}.impact-tag.serious{background:#fff3e0;color:#b45309}\n    .impact-tag.moderate{background:var(--yellow-bg);color:var(--yellow)}.impact-tag.minor{background:var(--blue-bg);color:var(--blue)}.impact-tag.informational{background:var(--line-soft);color:var(--gray)}\n    .audit-title{font-size:13px;font-weight:700;margin-bottom:4px}\n    .audit-finding{font-size:13px;color:var(--gray);margin-bottom:4px}.audit-rec{font-size:12px;color:var(--dark);font-style:italic;margin-bottom:4px}\n    .audit-geo{font-size:11px;color:var(--purple);background:var(--purple-bg);border:1px solid var(--purple-border);border-radius:4px;padding:3px 8px;display:inline-block;margin-top:4px}\n    .failing-els{margin-top:8px;display:flex;flex-direction:column;gap:4px}\n    .failing-el{font-family:var(--mono);font-size:11px;background:#1e1e2e;color:#a6e3a1;padding:6px 10px;border-radius:6px;white-space:pre-wrap;word-break:break-all}\n    .check-block{background:var(--line-soft);border:1px solid var(--line);border-radius:var(--r);padding:16px 20px;margin-bottom:12px}\n    .check-head{display:flex;align-items:center;gap:10px;margin-bottom:8px}\n    .check-icon{width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:800;flex-shrink:0}\n    .check-icon.pass{background:var(--green-bg);color:var(--green)}.check-icon.fail{background:var(--red-bg);color:var(--red)}\n    .check-title{font-size:14px;font-weight:700}.check-finding{font-size:13px;color:var(--gray);margin-bottom:6px}.check-rec{font-size:12px;color:var(--dark);font-style:italic}\n    .cls-level{display:inline-block;font-size:12px;font-weight:700;padding:3px 12px;border-radius:999px}\n    .cls-level.low{background:var(--green-bg);color:var(--green);border:1px solid var(--green-border)}\n    .cls-level.medium{background:var(--yellow-bg);color:var(--yellow);border:1px solid var(--yellow-border)}\n    .cls-level.high{background:var(--red-bg);color:var(--red);border:1px solid var(--red-border)}\n    .factor-list{margin:10px 0;padding-left:18px}.factor-list li{font-size:13px;color:var(--gray);margin-bottom:4px}\n    .qw-item{background:var(--blue-bg);border:1px solid var(--blue-border);border-radius:var(--r);padding:14px 16px;margin:8px 0}\n    .qw-head{display:flex;align-items:center;gap:8px;font-size:13px;font-weight:700;margin-bottom:4px}.qw-impact{font-size:12px;color:var(--gray);margin-bottom:4px}\n    .qw-geo{font-size:11px;color:var(--purple);background:var(--purple-bg);border:1px solid var(--purple-border);border-radius:4px;padding:3px 8px;margin-top:4px;display:inline-block}\n    .effort-badge{font-size:10px;font-weight:700;padding:2px 8px;border-radius:4px;text-transform:uppercase}\n    .effort-badge.low{background:var(--green-bg);color:var(--green)}.effort-badge.medium{background:var(--yellow-bg);color:var(--yellow)}.effort-badge.high{background:var(--red-bg);color:var(--red)}\n    .tree-status{border-radius:8px;padding:12px 16px;margin-bottom:16px;font-size:13px;font-weight:700}\n    .tree-status.ok{background:var(--green-bg);border:1px solid var(--green-border);color:var(--green)}\n    .tree-status.bad{background:var(--red-bg);border:1px solid var(--red-border);color:var(--red)}\n    .tree-status.blocked{background:var(--slate-bg);border:1px solid var(--slate-border);color:var(--slate)}\n    @media(max-width:768px){.header{padding:0 20px}.hero{padding:32px 20px 80px}.wrap{padding:0 20px;margin-top:-40px}.card{padding:24px 20px}.input-row{flex-direction:column}.run-btn{width:100%}}\n  </style>\n</head>\n<body>\n  <header class=\"header\">\n    <div class=\"header-inner\">\n      <img src=\"https://creativosbr.com.br/wp-content/uploads/2022/08/cadastra-1638546176-logopng.png\" class=\"logo\" alt=\"Cadastra\">\n      <div class=\"product-name\">Agentic <span>Browsing</span> Auditor</div>\n      <span class=\"version-badge\">v2 · GEO</span>\n    </div>\n  </header>\n\n  <section class=\"hero\">\n    <div class=\"hero-inner\">\n      <div class=\"hero-eyebrow\">LIGHTHOUSE · AGENTIC BROWSING · GEO · AI READINESS</div>\n      <h1>Agentic Browsing Auditor</h1>\n      <p class=\"hero-desc\">Análise de qualificação da página para acesso por agentes de IA — com lente GEO (Generative Engine Optimization) para garantir que ChatGPT, Perplexity, Gemini e agentes autônomos possam acessar, entender e interagir com o site.</p>\n      <div class=\"hero-badges\">\n        <div class=\"hero-badge\">Anti-bot Detection</div>\n        <div class=\"hero-badge\">12 Audits Lighthouse</div>\n        <div class=\"hero-badge\">GEO Readiness</div>\n        <div class=\"hero-badge\">llms.txt</div>\n        <div class=\"hero-badge\">WebMCP</div>\n        <div class=\"hero-badge\">CLS Risk</div>\n        <div class=\"hero-badge\">Score X/Y</div>\n      </div>\n    </div>\n  </section>\n\n  <div class=\"wrap\">\n    <div class=\"card\">\n      <div class=\"card-title\">🤖 Análise de Agentic Browsing</div>\n      <div class=\"card-sub\">Insira a URL da página e receba a análise de qualificação para acesso por agentes de IA, conforme critérios do Google Lighthouse Agentic Browsing e boas práticas de GEO.</div>\n      <form id=\"form\">\n        <div class=\"form-group\">\n          <label class=\"form-label\" for=\"url\">URL da Página</label>\n          <input class=\"q-input\" type=\"url\" id=\"url\" placeholder=\"https://www.seusite.com.br/pagina\" required autocomplete=\"off\">\n        </div>\n        <div class=\"form-group\">\n          <label class=\"form-label\" for=\"context\">Contexto Adicional (opcional)</label>\n          <textarea class=\"q-input\" id=\"context\" placeholder=\"Ex: E-commerce B2C, página de produto, público geral\"></textarea>\n        </div>\n        <div class=\"input-row\">\n          <button class=\"run-btn\" type=\"submit\" id=\"btn\">🤖 Analisar Página</button>\n        </div>\n        <div class=\"features-box\">\n          <h3>O que será auditado (Lighthouse Agentic Browsing + GEO)</h3>\n          <div class=\"feat-grid\">\n            <div class=\"feat-item\"><div class=\"feat-check\">✓</div><span>Score <b>X/Y</b> + GEO Readiness</span></div>\n            <div class=\"feat-item\"><div class=\"feat-check\">✓</div><span>Detecção de bloqueio anti-bot</span></div>\n            <div class=\"feat-item\"><div class=\"feat-check\">✓</div><span><span class=\"feat-code\">button-name</span> — botões com nome acessível</span></div>\n            <div class=\"feat-item\"><div class=\"feat-check\">✓</div><span><span class=\"feat-code\">link-name</span> — links com texto discernível</span></div>\n            <div class=\"feat-item\"><div class=\"feat-check\">✓</div><span><span class=\"feat-code\">label</span> — inputs com label associado</span></div>\n            <div class=\"feat-item\"><div class=\"feat-check\">✓</div><span><span class=\"feat-code\">image-alt</span> — imagens com alt text</span></div>\n            <div class=\"feat-item\"><div class=\"feat-check\">✓</div><span>ARIA — roles, atributos e aria-hidden</span></div>\n            <div class=\"feat-item\"><div class=\"feat-check\">✓</div><span>Landmarks <span class=\"feat-code\">&lt;main&gt;</span> e skip links</span></div>\n            <div class=\"feat-item\"><div class=\"feat-check\">✓</div><span>Hierarquia de headings e IDs duplicados</span></div>\n            <div class=\"feat-item\"><div class=\"feat-check\">✓</div><span>llms.txt — presença e estrutura válida</span></div>\n            <div class=\"feat-item\"><div class=\"feat-check\">✓</div><span>WebMCP — Model Context Protocol</span></div>\n            <div class=\"feat-item\"><div class=\"feat-check\">✓</div><span>CLS Risk — fatores de instabilidade visual</span></div>\n          </div>\n        </div>\n      </form>\n    </div>\n\n    <div class=\"loading\" id=\"loading\">\n      <div class=\"spinner\"></div>\n      <div class=\"loading-title\">Analisando a página...</div>\n      <div class=\"loading-sub\">O agente está verificando acessibilidade, anti-bot, llms.txt e GEO readiness</div>\n      <div class=\"timer-wrap\">\n        <div class=\"timer-bar-bg\"><div class=\"timer-bar-fill\" id=\"timerFill\"></div></div>\n        <div class=\"timer-label\" id=\"timerLabel\">0s / 90s</div>\n      </div>\n    </div>\n\n    <div class=\"err-box\" id=\"errBox\">\n      <h4>Erro na análise</h4>\n      <p id=\"errMsg\">Não foi possível completar a auditoria. Verifique a URL e tente novamente.</p>\n    </div>\n\n    <div class=\"results\" id=\"results\"></div>\n  </div>\n\n  <script>\n    const esc=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#039;'}[c]));\n    const TIMEOUT_MS=90000;let timerInterval=null;\n    function startTimer(){const fill=document.getElementById('timerFill'),label=document.getElementById('timerLabel'),total=TIMEOUT_MS/1000,start=Date.now();fill.style.width='0%';timerInterval=setInterval(function(){const el=Math.round((Date.now()-start)/1000);fill.style.width=Math.min((el/total)*100,100)+'%';label.textContent=el+'s / '+total+'s';if(el>=total)clearInterval(timerInterval);},500);}\n    function stopTimer(){clearInterval(timerInterval);document.getElementById('timerFill').style.width='100%';}\n    function scClass(p,t){const r=t>0?p/t:0;return r>=0.8?'hi':r>=0.5?'mid':'lo';}\n    function stBadge(s){return '<span class=\"st-badge '+esc(s||'indeterminate')+'\">'+esc((s||'indeterminate').toUpperCase())+'</span>';}\n    function impTag(i){return i?'<span class=\"impact-tag '+esc(i)+'\">'+esc(i)+'</span>':'';}\n    function chkIcon(ok){return '<div class=\"check-icon '+(ok?'pass':'fail')+'\">'+(ok?'✓':'✗')+'</div>';}\n    function geoTag(txt){return txt?'<span class=\"audit-geo\">🤖 '+esc(txt)+'</span>':'';}\n\n    function renderResults(d){\n      const res=document.getElementById('results');\n      const passed=d.passed_count??0,total=d.total_count??15;\n      const pct=total>0?Math.round((passed/total)*100):0;\n      const at=d.accessibility_tree??{},llms=d.llms_txt??{},wmcp=d.webmcp??{},cls=d.cls_risk??{};\n      const geo=d.geo_readiness??{},infra=d.infrastructure_issues??[];\n\n      // Infrastructure alerts\n      const infraHtml=infra.map(function(i){\n        return '<div class=\"infra-alert\">'\n          +'<div class=\"infra-alert-head\">🚨 '+esc(i.type.replace(/-/g,' ').toUpperCase())+' — CRITICAL</div>'\n          +'<div class=\"infra-alert-body\">'+esc(i.description)+'</div>'\n          +(i.geo_impact?'<div class=\"infra-alert-geo\">🤖 GEO Impact: '+esc(i.geo_impact)+'</div>':'')\n          +(i.recommendation?'<div class=\"infra-alert-rec\">💡 '+esc(i.recommendation)+'</div>':'')\n          +'</div>';\n      }).join('');\n\n      const auditItems=(at.audits??[]).map(function(a){\n        const fels=(a.failing_elements&&a.failing_elements.length)?'<div class=\"failing-els\">'+a.failing_elements.slice(0,5).map(function(el){return '<div class=\"failing-el\">'+esc(el)+'</div>';}).join('')+'</div>':'';\n        return '<div class=\"audit-item '+esc(a.status??'indeterminate')+'\">'\n          +'<div class=\"audit-head\"><span class=\"audit-id\">'+esc(a.id)+'</span>'+stBadge(a.status)+impTag(a.impact)+'</div>'\n          +'<div class=\"audit-title\">'+esc(a.title)+'</div>'\n          +(a.finding?'<div class=\"audit-finding\">'+esc(a.finding)+'</div>':'')\n          +fels\n          +(a.recommendation?'<div class=\"audit-rec\">💡 '+esc(a.recommendation)+'</div>':'')\n          +geoTag(a.geo_impact)\n          +'</div>';\n      }).join('');\n\n      const clsFactors=(cls.factors??[]).map(function(f){return '<li>'+esc(f)+'</li>';}).join('');\n\n      const qwItems=(d.top_quick_wins??[]).map(function(qw){\n        return '<div class=\"qw-item\">'\n          +'<div class=\"qw-head\"><strong>#'+qw.priority+'</strong>&nbsp;'+esc(qw.action)+(qw.effort?'<span class=\"effort-badge '+esc(qw.effort)+'\">'+esc(qw.effort)+'</span>':'')+'</div>'\n          +'<div class=\"qw-impact\">📈 '+esc(qw.expected_impact)+'</div>'\n          +(qw.geo_context?'<div class=\"qw-geo\">🤖 '+esc(qw.geo_context)+'</div>':'')\n          +(qw.audit_id?'<div style=\"font-size:11px;color:var(--gray-light);font-family:var(--mono);margin-top:6px\">'+esc(qw.audit_id)+'</div>':'')\n          +'</div>';\n      }).join('');\n\n      const treeBlocked=infra.some(function(i){return i.type==='anti-bot-block';});\n      const treeStatusClass=treeBlocked?'blocked':at.is_well_formed?'ok':'bad';\n      const treeStatusText=treeBlocked?'⚠️ Auditoria indisponível — página bloqueada por anti-bot':at.is_well_formed?'✓ Accessibility tree is well-formed':'⚠️ Accessibility tree is not well-formed';\n      const geoLvl=(geo.level||'poor').toLowerCase();\n\n      res.innerHTML=\n        infraHtml\n        +'<div class=\"section\">'\n          +'<div class=\"section-head\" onclick=\"toggle(this)\"><span class=\"section-title\">📊 Score & GEO Readiness</span><span>▾</span></div>'\n          +'<div class=\"section-body\">'\n            +'<div class=\"kpi-grid\">'\n              +'<div class=\"kpi\"><div class=\"kpi-val score-frac '+scClass(passed,total)+'\">'+passed+'/'+total+'</div><div class=\"kpi-lbl\">Audits Aprovados</div></div>'\n              +'<div class=\"kpi\"><div class=\"kpi-val\">'+pct+'%</div><div class=\"kpi-lbl\">Taxa de Aprovação</div></div>'\n              +'<div class=\"kpi\"><div class=\"kpi-val\">'+(at.passed??0)+'/'+(at.total??12)+'</div><div class=\"kpi-lbl\">Acessibilidade</div></div>'\n              +'<div class=\"kpi\"><div class=\"kpi-val\"><span class=\"geo-badge '+geoLvl+'\">'+geoLvl.toUpperCase()+'</span></div><div class=\"kpi-lbl\">GEO Readiness</div></div>'\n              +'<div class=\"kpi\"><div class=\"kpi-val\"><span class=\"cls-level '+esc(cls.level??'low')+'\">'+esc((cls.level??'N/A').toUpperCase())+'</span></div><div class=\"kpi-lbl\">CLS Risk</div></div>'\n            +'</div>'\n            +(geo.main_barrier?'<p style=\"font-size:13px;margin-bottom:10px;color:var(--red);font-weight:600\">⚠️ Principal barreira: '+esc(geo.main_barrier)+'</p>':'')\n            +(d.summary?'<p style=\"font-size:14px;line-height:1.7;color:var(--gray)\">'+esc(d.summary)+'</p>':'')\n          +'</div>'\n        +'</div>'\n        +'<div class=\"section\">'\n          +'<div class=\"section-head\" onclick=\"toggle(this)\"><span class=\"section-title\">🌳 Árvore de Acessibilidade — '+(at.passed??0)+'/'+(at.total??12)+' aprovados</span><span>▾</span></div>'\n          +'<div class=\"section-body\"><div class=\"tree-status '+treeStatusClass+'\">'+treeStatusText+'</div>'+(auditItems||'<p style=\"color:var(--gray);font-size:13px\">Nenhum audit retornado.</p>')+'</div>'\n        +'</div>'\n        +'<div class=\"section\">'\n          +'<div class=\"section-head\" onclick=\"toggle(this)\"><span class=\"section-title\">📄 llms.txt — '+(llms.present&&llms.valid?'✓ Válido':llms.present?'⚠️ Presente mas inválido':'✗ Ausente')+'</span><span>▾</span></div>'\n          +'<div class=\"section-body\"><div class=\"check-block\">'\n            +'<div class=\"check-head\">'+chkIcon(!!llms.present)+'<span class=\"check-title\">Arquivo llms.txt '+(llms.present?'encontrado em /llms.txt':'não encontrado')+'</span></div>'\n            +(llms.present?'<div class=\"check-head\">'+chkIcon(!!llms.valid)+'<span class=\"check-title\">Estrutura '+(llms.valid?'válida':'inválida ou incompleta')+'</span></div>':'')\n            +(llms.finding?'<div class=\"check-finding\">'+esc(llms.finding)+'</div>':'')\n            +(llms.content_preview?'<div class=\"failing-el\" style=\"margin:8px 0\">'+esc(llms.content_preview)+'</div>':'')\n            +(llms.recommendation?'<div class=\"check-rec\">💡 '+esc(llms.recommendation)+'</div>':'')\n          +'</div></div>'\n        +'</div>'\n        +'<div class=\"section\">'\n          +'<div class=\"section-head\" onclick=\"toggle(this)\"><span class=\"section-title\">🔌 WebMCP — '+(wmcp.present?'✓ Detectado':'✗ Não detectado')+'</span><span>▾</span></div>'\n          +'<div class=\"section-body\"><div class=\"check-block\"><div class=\"check-head\">'+chkIcon(!!wmcp.present)+'<span class=\"check-title\">WebMCP '+(wmcp.present?'detectado':'não detectado')+'</span></div>'+(wmcp.finding?'<div class=\"check-finding\">'+esc(wmcp.finding)+'</div>':'')+(wmcp.recommendation?'<div class=\"check-rec\">💡 '+esc(wmcp.recommendation)+'</div>':'')+'</div></div>'\n        +'</div>'\n        +'<div class=\"section\">'\n          +'<div class=\"section-head\" onclick=\"toggle(this)\"><span class=\"section-title\">📐 CLS Risk — <span class=\"cls-level '+esc(cls.level??'low')+'\">'+esc((cls.level??'LOW').toUpperCase())+'</span></span><span>▾</span></div>'\n          +'<div class=\"section-body\">'+(clsFactors?'<ul class=\"factor-list\">'+clsFactors+'</ul>':'<p style=\"color:var(--gray);font-size:13px\">Nenhum fator de risco identificado.</p>')+(cls.recommendation?'<p style=\"font-size:13px;font-style:italic;margin-top:12px;color:var(--dark)\">💡 '+esc(cls.recommendation)+'</p>':'')+'</div>'\n        +'</div>'\n        +'<div class=\"section\">'\n          +'<div class=\"section-head\" onclick=\"toggle(this)\"><span class=\"section-title\">⚡ Top Quick Wins</span><span>▾</span></div>'\n          +'<div class=\"section-body\">'+(qwItems||'<p style=\"color:var(--gray);font-size:13px\">Nenhum quick win disponível.</p>')+'</div>'\n        +'</div>';\n\n      res.classList.add('on');\n    }\n\n    function toggle(head){head.nextElementSibling.classList.toggle('hidden');}\n    document.getElementById('form').addEventListener('submit',function(e){\n      e.preventDefault();\n      var url=document.getElementById('url').value.trim();\n      var context=document.getElementById('context').value.trim();\n      var btn=document.getElementById('btn'),loading=document.getElementById('loading'),errBox=document.getElementById('errBox'),results=document.getElementById('results');\n      btn.disabled=true;btn.textContent='⏳ Analisando...';\n      loading.classList.add('on');errBox.classList.remove('on');results.classList.remove('on');results.innerHTML='';\n      startTimer();\n      fetch(window.location.pathname,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({url:url,context:context}),signal:AbortSignal.timeout(TIMEOUT_MS+5000)})\n        .then(function(res){stopTimer();if(!res.ok)throw new Error('Erro HTTP '+res.status);return res.json();})\n        .then(function(raw){var d=raw.data??raw.result??raw.json??raw;renderResults(d);})\n        .catch(function(err){stopTimer();errBox.classList.add('on');document.getElementById('errMsg').textContent=err.message||'Erro inesperado.';})\n        .finally(function(){loading.classList.remove('on');btn.disabled=false;btn.textContent='🤖 Analisar Página';});\n    });\n  </script>\n</body>\n</html>",
        "options": {
