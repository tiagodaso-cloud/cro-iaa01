        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\n// If upstream node failed, item may contain 'error' key from n8n\nconst upstreamError = item.error?.message ?? item.errorMessage ?? null;\nconst raw = item.output ?? '';\n\nif (upstreamError && !raw) {\n  return { json: {\n    error: true,\n    message: 'Erro no agente LLM: ' + upstreamError,\n    url: (() => { try { return $('Prepare Context').item.json.url; } catch(e){ return ''; } })()\n  }};\n}\n\ntry {\n  const match = raw.match(/\\{[\\s\\S]*\\}/);\n  if (!match) throw new Error('JSON nao encontrado na resposta do modelo.');\n  const d = JSON.parse(match[0]);\n  return { json: { ...d, url: (() => { try { return $('Prepare Context').item.json.url; } catch(e){ return d.url ?? ''; } })() } };\n} catch(e) {\n  return { json: {\n    error: true,\n    message: 'Falha ao processar resposta: ' + e.message,\n    raw_preview: raw.substring(0, 500),\n    url: (() => { try { return $('Prepare Context').item.json.url; } catch(e2){ return ''; } })()\n  }};\n}"
